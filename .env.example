# ---- Wallet (Base Sepolia testnet only, never mainnet funds) ----
# Buyer wallet: the orchestrator signs x402 payments with this key. Generate with `python wallet/generate_wallet.py`.
BUYER_PRIVATE_KEY=0xGENERATED_BY_wallet_generate_SCRIPT
BUYER_ADDRESS=0xGENERATED_BY_wallet_generate_SCRIPT
# Seller payout address: where all microservices receive USDC. Generated alongside the buyer key.
SELLER_PAYTO_ADDRESS=0xGENERATED_BY_wallet_generate_SCRIPT

# Base Sepolia RPC (public default is fine for a hackathon demo)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# x402 facilitator (public testnet facilitator, no account needed)
X402_FACILITATOR_URL=https://x402.org/facilitator

# ---- LLM provider ----
# Both free. Groq (https://console.groq.com/keys) does the cheap/fast tier: planner,
# fact-check, enrichment, summarizer. Gemini (https://aistudio.google.com/apikey) does
# the strong tier: final report synthesis only. Each is independent - the whole
# pipeline runs on heuristics without either, degraded LLM-wise only for the tier
# whose key is missing.
GROQ_API_KEY=
GEMINI_API_KEY=
# Cheap/fast tier model (Groq)
LLM_MODEL_CHEAP_GROQ=llama-3.3-70b-versatile
# Strong tier model (Gemini). The 2.x line still shows up in the models listing but
# 404s for newly created keys ("no longer available to new users"), so 3.5 Flash is
# the working default. Leave GEMINI_API_KEY blank and the strong tier quietly falls
# back to Groq - the pipeline still runs, just without the stronger synthesis model.
LLM_MODEL_STRONG_GEMINI=gemini-3.5-flash

# ---- Optional real search provider (falls back to curated mock data if unset) ----
TAVILY_API_KEY=

# ---- Service ports ----
PORT_SEARCH=4001
PORT_FACT_CHECK=4002
PORT_ENRICHMENT=4003
PORT_SUMMARIZER=4004
PORT_REPORT_GEN=4005
PORT_REPORT_GEN_CHEAP=4006
PORT_ORCHESTRATOR=4000
PORT_SEARCH_B=4007
PORT_SEARCH_C=4008

# ---- Spend limits (the wallet's safety net) ----
# Every research job pays real testnet USDC out of one shared buyer wallet, so the
# orchestrator enforces its own ceilings regardless of what a client asks for. These
# defaults are sized for a demo: a job costs ~$0.019, so 1 USDC/day is ~50 jobs.
#
# Leave REQUIRE_API_KEY unset for local development - the React frontend and the demo
# scripts then work with no key, sharing the anonymous quota below. Set it to true
# before exposing the orchestrator to the internet, which blocks anonymous jobs
# entirely; mint keys with `python scripts/manage_keys.py create <label>`.
REQUIRE_API_KEY=false
ANON_DAILY_CAP_USDC=1.0
ANON_MAX_JOB_BUDGET_USDC=0.30
ANON_MAX_JOBS_PER_HOUR=60
# Hard ceiling across every caller and key combined - the last line of defence.
GLOBAL_DAILY_CAP_USDC=5.0

# ---- MCP server (mcp_server/) ----
# Which orchestrator the MCP server talks to, and the key it presents. Only needed if
# you run `python -m mcp_server`; usually set in the MCP client's own config instead
# (see mcp_server/README.md) rather than here.
AUTORESEARCH_API_URL=http://localhost:4000
AUTORESEARCH_API_KEY=

# Base URLs the orchestrator uses to reach each service (override for docker/remote)
SEARCH_URL=http://localhost:4001
FACT_CHECK_URL=http://localhost:4002
ENRICHMENT_URL=http://localhost:4003
SUMMARIZER_URL=http://localhost:4004
REPORT_GEN_URL=http://localhost:4005
REPORT_GEN_CHEAP_URL=http://localhost:4006
SEARCH_B_URL=http://localhost:4007
SEARCH_C_URL=http://localhost:4008
